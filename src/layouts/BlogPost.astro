---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getLangFromUrl } from '../i18n/utils';
import { getArticlesByLang, getArticleUrl } from '../i18n/posts';

type Props = CollectionEntry<'articles'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroAlt } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const allArticles = await getArticlesByLang(lang);
const related = allArticles.filter((a) => a.data.title !== title).slice(0, 3);
const updatedLabel = lang === 'en' ? 'Last updated on' : 'Dernière mise à jour le';
// Texte alternatif du hero : heroAlt si fourni, sinon le titre de l'article.
const heroAltText = heroAlt ?? title;
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"headline": title,
			"description": description,
			"datePublished": pubDate.toISOString(),
			...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
			"author": {
				"@type": "Organization",
				"name": lang === 'en' ? "LIP Industrie Editorial Team" : "Rédaction LIP Industrie",
				"url": "https://www.lip-industrie.com/"
			},
			"publisher": {
				"@type": "Organization",
				"name": "LIP Industrie Précision",
				"url": "https://www.lip-industrie.com/",
				"logo": {
					"@type": "ImageObject",
					"url": new URL('/logo-lip-vert.png', Astro.site).toString()
				}
			},
			"inLanguage": lang === 'en' ? "en" : "fr",
			"url": new URL(Astro.url.pathname, Astro.site).toString()
		})} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				width: auto;
				max-width: min(100%, 1020px);
				height: auto;
				/* Évite qu'une photo portrait occupe tout l'écran ; le filigrane
				   reste visible car l'image n'est pas recadrée. */
				max-height: 70vh;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			@media (max-width: 480px) {
				.hero-image img {
					max-height: 45vh;
				}
				.title {
					padding: 0.5em 0;
				}
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.author-byline {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				justify-content: center;
				margin-top: 0.6em;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.author-byline img {
				width: 22px;
				height: auto;
				border-radius: 0;
				box-shadow: none;
				display: inline;
			}
			.author-byline span {
				font-weight: 600;
				color: var(--accent);
			}
			/* --- Articles similaires --- */
			.related {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 2.5em auto 3em;
				padding: 0 1em;
			}
			.related h2 {
				font-size: 1.1rem;
				font-weight: 700;
				color: rgb(var(--gray-dark));
				margin-bottom: 1rem;
				border-top: 1px solid rgb(var(--gray-light));
				padding-top: 1.5rem;
			}
			.related-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
			}
			.related-card {
				display: flex;
				flex-direction: column;
				border-radius: 10px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
				text-decoration: none;
				color: inherit;
				background: #fff;
				transition: transform 0.18s ease, box-shadow 0.18s ease;
			}
			.related-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 6px 20px rgba(var(--gray), 35%), 0 16px 40px rgba(var(--gray), 20%);
			}
			.related-card img {
				width: 100%;
				height: 110px;
				object-fit: cover;
				display: block;
			}
			.related-card .rc-body {
				padding: 0.65rem 0.85rem 0.85rem;
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}
			.related-card .rc-label {
				font-size: 0.68rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--accent);
			}
			.related-card .rc-title {
				font-size: 0.88rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 0;
				line-height: 1.3;
			}
			@media (max-width: 640px) {
				.related-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{
						heroImage && (
							<Image width={1020} src={heroImage} alt={heroAltText} title={heroAltText} />
						)
					}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{updatedLabel} <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<div class="author-byline">
							<img src="/logo-lip-vert.png" alt="LIP Industrie Précision" width="22" height="26" />
							<span>{lang === 'en' ? 'LIP Industrie Editorial Team' : 'Rédaction LIP Industrie'}</span>
						</div>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>

		{related.length > 0 && (
			<section class="related">
				<h2>{lang === 'en' ? 'More articles' : 'Articles similaires'}</h2>
				<div class="related-grid">
					{related.map((a) => (
						<a href={getArticleUrl(a)} class="related-card">
							{a.data.heroImage && (
								<Image
									width={320}
									height={110}
									src={a.data.heroImage}
									alt={a.data.heroAlt ?? a.data.title}
								/>
							)}
							<div class="rc-body">
								<span class="rc-label">{lang === 'en' ? 'Article' : 'Article'}</span>
								<p class="rc-title">{a.data.title}</p>
							</div>
						</a>
					))}
				</div>
			</section>
		)}

		<Footer />
	</body>
</html>
