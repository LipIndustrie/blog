---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getLangFromUrl } from '../i18n/utils';

type Props = CollectionEntry<'articles'>['data'];

const { title, description, pubDate, updatedDate, heroImage, heroAlt } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const updatedLabel = lang === 'en' ? 'Last updated on' : 'Dernière mise à jour le';
// Texte alternatif du hero : heroAlt si fourni, sinon le titre de l'article.
const heroAltText = heroAlt ?? title;
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			"headline": title,
			"description": description,
			"datePublished": pubDate.toISOString(),
			...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
			"author": {
				"@type": "Organization",
				"name": lang === 'en' ? "LIP Industrie Editorial Team" : "Rédaction LIP Industrie",
				"url": "https://www.lip-industrie.com/"
			},
			"publisher": {
				"@type": "Organization",
				"name": "LIP Industrie Précision",
				"url": "https://www.lip-industrie.com/",
				"logo": {
					"@type": "ImageObject",
					"url": new URL('/logo-lip-vert.png', Astro.site).toString()
				}
			},
			"inLanguage": lang === 'en' ? "en" : "fr",
			"url": new URL(Astro.url.pathname, Astro.site).toString()
		})} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				width: auto;
				max-width: min(100%, 1020px);
				height: auto;
				/* Évite qu'une photo portrait occupe tout l'écran ; le filigrane
				   reste visible car l'image n'est pas recadrée. */
				max-height: 70vh;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			@media (max-width: 480px) {
				.hero-image img {
					max-height: 45vh;
				}
				.title {
					padding: 0.5em 0;
				}
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.author-byline {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				justify-content: center;
				margin-top: 0.6em;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.author-byline img {
				width: 22px;
				height: auto;
				border-radius: 0;
				box-shadow: none;
				display: inline;
			}
			.author-byline span {
				font-weight: 600;
				color: var(--accent);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{
						heroImage && (
							<Image width={1020} src={heroImage} alt={heroAltText} title={heroAltText} />
						)
					}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{updatedLabel} <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<div class="author-byline">
							<img src="/logo-lip-vert.png" alt="LIP Industrie Précision" width="22" height="26" />
							<span>{lang === 'en' ? 'LIP Industrie Editorial Team' : 'Rédaction LIP Industrie'}</span>
						</div>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
