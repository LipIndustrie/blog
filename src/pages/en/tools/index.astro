---
import { Image } from 'astro:assets';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import { getToolsByLang, getToolUrl } from '../../../i18n/posts';
import { useTranslations } from '../../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const tools = await getToolsByLang(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t('tools.title')} | ${SITE_TITLE}`} description={t('tools.intro')} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
			}
			ul {
				list-style: none;
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem;
				margin: 2rem 0 0;
				padding: 0;
			}
			li a {
				display: flex;
				flex-direction: column;
				border-radius: 14px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
				text-decoration: none;
				color: inherit;
				background: #fff;
				transition: transform 0.18s ease, box-shadow 0.18s ease;
			}
			li a:hover {
				transform: translateY(-3px);
				box-shadow: 0 6px 20px rgba(var(--gray), 35%), 0 16px 40px rgba(var(--gray), 20%);
			}
			li a img {
				width: 100%;
				height: 160px;
				object-fit: cover;
				display: block;
			}
			.tool-body {
				padding: 1rem 1.25rem 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}
			.tool-label {
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #b45309;
			}
			.tool-title {
				margin: 0 0 0.25rem;
				font-size: 1rem;
				font-weight: 700;
				color: rgb(var(--black));
				line-height: 1.3;
			}
			.tool-desc {
				margin: 0;
				font-size: 0.85rem;
				color: rgb(var(--gray-dark));
			}
			li a:hover .tool-title {
				color: var(--accent);
			}
			.empty {
				color: rgb(var(--gray));
			}
			@media (max-width: 600px) {
				ul { grid-template-columns: 1fr; }
			}
			@media (max-width: 480px) {
				ul { gap: 0.75rem; }
				.tool-body { padding: 0.75rem 1rem 1rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{t('tools.title')}</h1>
			<p>{t('tools.intro')}</p>
			{
				tools.length === 0 ? (
					<p class="empty">Coming soon.</p>
				) : (
					<ul>
						{tools.map((tool) => (
							<li>
								<a href={getToolUrl(tool)}>
									{tool.data.heroImage && (
										<Image
											width={480}
											height={160}
											src={tool.data.heroImage}
											alt={tool.data.heroAlt ?? tool.data.title}
										/>
									)}
									<div class="tool-body">
										<span class="tool-label">Tool</span>
										<h2 class="tool-title">{tool.data.title}</h2>
										<p class="tool-desc">{tool.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
