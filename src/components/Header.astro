---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
import {
	getLangFromUrl,
	useTranslations,
	localizePath,
	getAlternatePath,
	getSectionPath,
	getSectionFromUrl,
} from '../i18n/utils';
import { ui, flags } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = localizePath('/', lang);
const section = getSectionFromUrl(Astro.url);
const altLang = lang === 'fr' ? 'en' : 'fr';
const altHref = getAlternatePath(Astro.url, altLang);
---

<header>
	<nav>
		<a href={homeHref} class="logo-link">
			<img src="/logo-lip-vert.png" alt="LIP Industrie" height="40" width="36" />
			<span class="logo-text">LIP Industrie</span>
		</a>
		<div class="internal-links">
			<HeaderLink href={localizePath('/', lang)}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={getSectionPath('articles', lang)} active={section === 'articles'}>
				{t('nav.articles')}
			</HeaderLink>
			<HeaderLink href={getSectionPath('tools', lang)} active={section === 'tools'}>
				{t('nav.tools')}
			</HeaderLink>
			<HeaderLink href={localizePath('/about', lang)}>{t('nav.about')}</HeaderLink>
			<a class="lang-switch" href={altHref} hreflang={altLang}>
				<span class="flag" aria-hidden="true">{flags[altLang]}</span>{ui[lang]['lang.switchTo']}
			</a>
		</div>
		<SocialLinks variant="header" />
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.5em 0;
		text-decoration: none;
	}
	.logo-link img {
		display: block;
	}
	.logo-text {
		font-size: 0.85em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1.1;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
	}
	.flag {
		font-size: 1.1em;
		line-height: 1;
	}
</style>
