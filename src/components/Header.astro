---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
import {
	getLangFromUrl,
	useTranslations,
	localizePath,
	getAlternatePath,
	getSectionPath,
	getSectionFromUrl,
} from '../i18n/utils';
import { ui, flags } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = localizePath('/', lang);
const section = getSectionFromUrl(Astro.url);
const altLang = lang === 'fr' ? 'en' : 'fr';
const altHref = getAlternatePath(Astro.url, altLang);
---

<header>
	<nav id="main-nav">
		<a href={homeHref} class="logo-link">
			<img src="/logo-lip-vert.png" alt="LIP Industrie" height="40" width="36" />
			<div class="logo-text">
				<span class="logo-name">LIP Industrie</span>
				<span class="logo-sub">Le blog</span>
			</div>
		</a>
		<button class="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
			<span></span><span></span><span></span>
		</button>
		<div class="internal-links" id="nav-links">
			<HeaderLink href={getSectionPath('articles', lang)} active={section === 'articles'}>
				{t('nav.articles')}
			</HeaderLink>
			<HeaderLink href={getSectionPath('tools', lang)} active={section === 'tools'}>
				{t('nav.tools')}
			</HeaderLink>
			<HeaderLink href={localizePath('/about', lang)}>{t('nav.about')}</HeaderLink>
			<a class="lang-switch" href={altHref} hreflang={altLang}>
				<span class="flag" aria-hidden="true">{flags[altLang]}</span>{ui[lang]['lang.switchTo']}
			</a>
		</div>
		<SocialLinks variant="header" />
	</nav>
</header>

<script>
	const btn = document.querySelector('.hamburger') as HTMLButtonElement;
	const nav = document.getElementById('main-nav');
	btn?.addEventListener('click', () => {
		const open = nav?.classList.toggle('nav-open');
		btn.setAttribute('aria-expanded', String(open));
	});
</script>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.5em 0;
		text-decoration: none;
		flex-shrink: 0;
	}
	.logo-link img {
		display: block;
	}
	.logo-text {
		display: flex;
		flex-direction: column;
		justify-content: center;
		line-height: 1.15;
	}
	.logo-name {
		font-size: 0.85em;
		font-weight: 700;
		color: var(--accent);
	}
	.logo-sub {
		font-size: 0.7em;
		font-weight: 400;
		color: rgb(var(--gray));
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
	}
	.flag {
		font-size: 1.1em;
		line-height: 1;
	}

	/* Hamburger — caché sur desktop */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 36px;
		height: 36px;
		padding: 6px;
		background: none;
		border: none;
		cursor: pointer;
		border-radius: 6px;
	}
	.hamburger span {
		display: block;
		height: 2px;
		background: rgb(var(--black));
		border-radius: 2px;
		transition: transform 0.2s, opacity 0.2s;
	}
	.hamburger:hover {
		background: rgb(var(--gray-light));
	}

	/* Mobile */
	@media (max-width: 640px) {
		.hamburger {
			display: flex;
		}
		.internal-links {
			display: none;
			width: 100%;
			flex-direction: column;
			align-items: flex-start;
			padding: 0.5em 0 1em;
			border-top: 1px solid rgb(var(--gray-light));
		}
		.internal-links a {
			padding: 0.75em 0.25em;
			width: 100%;
			border-bottom: none;
		}
		.internal-links a.active {
			border-bottom: none;
			color: var(--accent);
			font-weight: 700;
		}
		nav.nav-open .internal-links {
			display: flex;
		}
		/* Croix quand ouvert */
		nav.nav-open .hamburger span:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}
		nav.nav-open .hamburger span:nth-child(2) {
			opacity: 0;
		}
		nav.nav-open .hamburger span:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}
	}
</style>
