---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { active?: boolean };

const { href, class: className, active, ...props } = Astro.props;
// Normalise les chemins (retire le trailing slash) pour comparer la route
// courante au lien, en gardant le préfixe de langue éventuel (/en/...).
const normalize = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const current = normalize(Astro.url.pathname);
const target = normalize(String(href));
// `active` explicite (ex. détection de section) sinon comparaison de chemin.
const isActive =
	active ?? (current === target || (target !== '/' && current.startsWith(target + '/')));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
